VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-ou-anon-key>
# Opcional, só para `npm run smoke` checar a leitura logado (uma das duas contas). Sem isso, essa parte é pulada.
BUBS_EMAIL=
BUBS_PASSWORD=
# Google Maps (opcional; sem elas o app usa o OpenStreetMap). Passo a passo: docs/google-maps-setup.md
VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAP_ID=
